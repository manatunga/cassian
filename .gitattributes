# Auto detect text files and perform LF normalization on check-in
* text=auto

# Enforce LF line endings for Python and documentation files
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.rst text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf

# Keep binary files untouched by Git line ending transformations
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary